# trce report reel, portrait so the whole report stays on screen. Render: vhs011 report-portrait.tape
Output report-portrait.mp4
Output report-portrait.gif

Set Shell zsh
Set FontFamily "JetBrains Mono"
Set FontSize 16
Set LineHeight 1.25
Set Width 1200
Set Height 1800
Set Padding 36
Set Theme { "background": "#0f0f14", "foreground": "#e6e4ee", "cursor": "#e6e4ee", "selection": "#2a2933" }
Set TypingSpeed 55ms

Hide
Type "clear"
Enter
Show

Sleep 900ms
Type "trce report"
Sleep 600ms
Enter
Sleep 16s
Sleep 4s
